{"posts": [{"id": "2095443560715723240", "author": "JeanRemiKing", "author_name": "Jean-Rémi King", "posted": "2026-09-03", "text": "🚨We have a new position for a 3 year PhD at FAIR (Meta) Paris starting this fall/winter:\n\nhttps://t.co/LpAplGe73t\n\nLooking for a candidate with strong ML/CS/AI background and a deep interest in computational neuroscience.\n\n(Please RT) ", "links": ["https://www.metacareers.com/profile/job_details/1774440550364950/"], "post_url": "https://x.com/JeanRemiKing/status/2095443560715723240", "avatar": "data:image/jpeg;base64,"}, {"id": "2094502545049915739", "author": "jihanyang13", "author_name": "Jihan Yang", "posted": "2026-08-31", "text": "New positions open! We’re looking for full-time researchers and interns with backgrounds in geometry and 3D vision to join our team at AMI Labs.\nThe roles can be based in NYC, Paris, Montreal, or Singapore. \n\nIf you’re interested, apply through the link below:", "links": [], "post_url": "https://x.com/jihanyang13/status/2094502545049915739", "avatar": "data:image/jpeg;base64,"}, {"id": "2091476599460057353", "author": "RHachiuma", "author_name": "Ryo Hachiuma", "posted": "2026-08-23", "text": "NVIDIA Research Taiwanチームで2027 Internshipの応募が公開されました！\n\n僕は以下のトピックで募集しています🙌\n✅ Safety for Embodied Agents\n✅ Video Understanding\n✅  Agentic VLMs\n....\n\n興味ある方はメールかDMください！\nrhachiuma [at] https://t.co/EM0QvyyfjK\n\nhttps://t.co/EX35nb1U0j", "links": ["http://nvidia.com", "https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite/job/Taiwan-Taipei/Artificial-Intelligence-Research-Intern---Deep-Learning_JR2023646"], "post_url": "https://x.com/RHachiuma/status/2091476599460057353", "avatar": "data:image/jpeg;base64,"}, {"id": "2090896086072197600", "author": "jonLorraine9", "author_name": "Jonathan Lorraine", "posted": "2026-08-21", "text": "New NVIDIA PhD research internships for 2027 🔍\n\nGenerative AI, LLMs, vision, graphics/simulation, robotics, autonomous vehicles.\n\nI’m interested in AI systems that automate and improve research.\n\nApply: https://t.co/o3WwKDGTVU ", "links": ["https://nvidia.wd5.myworkdayjobs.com/en-US/NVIDIAExternalCareerSite?q=research%20intern"], "post_url": "https://x.com/jonLorraine9/status/2090896086072197600", "avatar": "data:image/jpeg;base64,"}, {"id": "2090645729052418108", "author": "msraurjp", "author_name": "Microsoft Research Asia - Tokyo", "posted": "2026-08-21", "text": "[Join us at Microsoft Research Asia - Tokyo] We're looking for outstanding PhD students interested in Embodied AI, Vision-Language Models, Spatial AI, Computer Vision, and Robotics.\nHelp shape the future of AI in the physical world.\nhttps://t.co/UABjPntcGQ", "links": ["https://apply.careers.microsoft.com/careers/job/1970393556972877"], "post_url": "https://x.com/msraurjp/status/2090645729052418108", "avatar": "data:image/jpeg;base64,"}, {"id": "2089390434237780438", "author": "gabriberton", "author_name": "Gabriele Berton", "posted": "2026-08-17", "text": "My team at Google DeepMind is hiring a PhD/MS student researcher for fall 2026 to work on a project related to image+video representations\n\nLooking for a student with a strong research background in vision encoders, multimodal LLMs, or 4D perception\n\nLink in first comment", "links": [], "post_url": "https://x.com/gabriberton/status/2089390434237780438", "avatar": "data:image/png;base64,"}, {"id": "2056817794893898174", "author": "Aniket1836020", "author_name": "Aniket", "posted": "2026-05-19", "text": "#hiring Opportunity \n internship opening for summer/fall 2026---working with Samy Jelassi for Research Intern - Self-Improving AI\n\nApply here \nhttps://t.co/ecxgLMr5y6", "links": ["https://apply.careers.microsoft.com/careers/job/1970393556867858"], "post_url": "https://x.com/Aniket1836020/status/2056817794893898174", "avatar": "data:image/jpeg;base64,"}]}